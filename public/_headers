/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.tradingview.com https://*.tradingview-widget.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://*.tradingview.com https://*.tradingview-widget.com; img-src 'self' data: blob: https://*.tradingview.com https://*.tradingview-widget.com https://*.googleusercontent.com; connect-src 'self' https://*.tradingview.com https://*.tradingview-widget.com wss://*.tradingview.com wss://*.tradingview-widget.com https://*.googleapis.com https://*.firebaseapp.com https://www.gstatic.com; frame-src https://*.tradingview.com https://*.tradingview-widget.com https://*.firebaseapp.com https://accounts.google.com; font-src 'self' data: https://*.tradingview.com https://*.tradingview-widget.com; frame-ancestors 'none'; form-action 'self'; object-src 'none'; base-uri 'none'


# Revalidate HTML and PWA routing rather than reusing an older app shell.
# Has no effect on dynamic /api/* Pages Functions.
/
  Cache-Control: no-cache, must-revalidate
/v9.html
  Cache-Control: no-cache, must-revalidate
/v9
  Cache-Control: no-cache, must-revalidate
/research.html
  Cache-Control: no-cache, must-revalidate
/research
  Cache-Control: no-cache, must-revalidate
/account.html
  Cache-Control: no-cache, must-revalidate
/account
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
